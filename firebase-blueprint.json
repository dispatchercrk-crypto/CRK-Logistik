          "description": "Total Pengeluaran Tol in IDR."
        },
        "fotoStrukTolUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300,
          "description": "Optional Google Drive link for Toll receipt photo."
        },
        "totalPengeluaran": {
          "type": "number",
          "description": "Total combined BBM + Toll expense in IDR."
        },
        "catatan": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500,
          "description": "Optional driver note."
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the owning dispatcher."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "timestamp",
        "tanggal",
        "driverCode",
        "driverName",
        "plateNumber",
        "completedAssignmentNos",
        "fleetCardId",
        "fleetCardNumber",
        "totalPengirimanBbm",
        "totalPengeluaranTol",
        "totalPengeluaran",
        "catatan",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
