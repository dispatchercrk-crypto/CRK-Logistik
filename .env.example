# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WHATSAPP_API_URL: Optional server-side WhatsApp Gateway HTTP endpoint (e.g. https://api.fonnte.com/send or custom WA webhook URL).
WHATSAPP_API_URL=""

# WHATSAPP_API_TOKEN: Optional server-side authorization token for the WhatsApp Gateway.
WHATSAPP_API_TOKEN=""

# WHATSAPP_DEFAULT_TARGET: Default operational Dispatcher WhatsApp number (e.g. 6281234567890).
WHATSAPP_DEFAULT_TARGET=""

# GOOGLE_SPREADSHEET_ID: Optional default Google Spreadsheet ID for server auto-sync.
GOOGLE_SPREADSHEET_ID=""

# GOOGLE_APPS_SCRIPT_URL: Optional default Google Apps Script Web App (/exec) URL for 24/7 Spreadsheet bridge.
GOOGLE_APPS_SCRIPT_URL=""

# GOOGLE_SERVICE_ACCOUNT_JSON: Paste full Google Cloud Service Account JSON key (or Base64-encoded JSON) for official 24/7 Google Sheets & Drive API sync without Admin login.
GOOGLE_SERVICE_ACCOUNT_JSON="YOUR_GOOGLE_SERVICE_ACCOUNT_JSON"

# GOOGLE_SERVICE_ACCOUNT_EMAIL: Service Account client_email shared as Editor on the Google Spreadsheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL="crk-sheets-sync@gen-lang-client-0326301182.iam.gserviceaccount.com"

# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY: Optional alternative — paste only the private_key field from your Service Account JSON file.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="YOUR_GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY"

# GOOGLE_DRIVE_ROOT_FOLDER_ID: Optional Google Drive Folder ID shared (Editor) with the Service Account for 24/7 photo & receipt archiving.
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

